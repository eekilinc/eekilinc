// routes/api.php — Laravel hedef sunucuda bu stub birebir uygulanacak (Sanctum).
use Illuminate\Support\Facades\Route;
use App\Http\Controllers\Api\AuthController;
use App\Http\Controllers\Api\ExamController;
use App\Http\Controllers\Api\ScanController;

Route::post('/login', [AuthController::class, 'login']);
Route::middleware('auth:sanctum')->group(function () {
    Route::post('/logout', [AuthController::class, 'logout']);
    Route::get('/me', [AuthController::class, 'me']);
    Route::get('/exams', [ExamController::class, 'index']);
    Route::get('/exams/{exam}', [ExamController::class, 'show']); // form_spec dahil
    Route::post('/scans', [ScanController::class, 'store']);      // puan server'da hesaplanır
    Route::get('/exams/{exam}/scans', [ScanController::class, 'index']);
});
