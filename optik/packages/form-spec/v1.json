{
  "spec": "optik-form/v1",
  "page": { "size": "A4", "dpi": 300, "margin_mm": 0, "width_mm": 210, "height_mm": 297 },
  "anchors": {
    "type": "corner-squares",
    "size_norm": 0.043,
    "positions": { "tl": [0.04, 0.04], "tr": [0.96, 0.04], "bl": [0.04, 0.96], "br": [0.96, 0.96] }
  },
  "header": { "zone_norm": [0.06, 0.04, 0.72, 0.12] },
  "qr": { "zone_norm": [0.74, 0.04, 0.94, 0.12], "payload_format": "OPTIK1:{exam_id}:{form_version}:{booklet}:{checksum4}" },
  "defaults": { "question_count": 40, "option_count": 5, "options": ["A", "B", "C", "D", "E"] },
  "student_no": { "label": "Öğrenci No", "digits": 8, "zone_norm": [0.06, 0.17, 0.58, 0.30] },
  "booklet": { "label": "Kitapçık", "choices": ["A", "B", "C", "D"], "zone_norm": [0.62, 0.155, 0.94, 0.215], "single_mark": true },
  "questions": {
    "zone_norm": [0.06, 0.33, 0.94, 0.94],
    "layout": { "columns": 2, "rows_per_column": 20, "option_count_from": "exam.option_count" },
    "mark": { "shape": "circle", "fill_threshold": 0.25, "multi_mark": "review", "empty": "blank" }
  },
  "rules": {
    "booklet_required": true,
    "student_no_required": true,
    "login_required_to_scan": true,
    "multi_mark_policy": "review_not_wrong",
    "versioning": "qr.form_version ile form_templates.spec eşleşmeli, eski versiyon 410 değil review'e düşer"
  }
}